# Teman Kereta intentionally defaults to local-only development.
APP_ENV=local
# mock | gtfs | official_api | local_supabase — any other value silently
# falls back to mock (see AppEnvironment.provider), so keep it one of these.
TRANSIT_PROVIDER=mock
SUPABASE_ENABLED=false
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
API_BASE_URL=http://127.0.0.1:54321
MAP_STYLE_URL=
# Crash reporting via Sentry. Only ever active when APP_ENV is NOT local,
# even if a DSN is set here by accident — see AppEnvironment.crashReportingEnabled.
SENTRY_DSN=
FIREBASE_ENABLED=false

# Only read when TRANSIT_PROVIDER=gtfs. Point at official GTFS-Realtime feed
# URLs (protobuf). Leave blank to keep vehicle positions/trip updates/alerts
# on the demo provider. Schedule/station/places search still use the demo
# provider until a GTFS Schedule (static) importer is built.
GTFS_RT_VEHICLE_POSITIONS_URL=
GTFS_RT_TRIP_UPDATES_URL=
GTFS_RT_ALERTS_URL=
GTFS_RT_POLL_SECONDS=30
