{
  "manifest_version": 3,
  "name": "Admin Teman Kereta – Asisten Balas Komentar",
  "short_name": "Admin TK",
  "version": "1.0.0",
  "description": "Saran balasan komentar sebagai Admin Teman Kereta. Komentar soal kebablasan dibalas dengan soft selling Alarm Sisa Stasiun. Tidak pernah mengirim otomatis.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Admin Teman Kereta",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://www.threads.com/*",
        "https://www.threads.net/*",
        "https://www.tiktok.com/*",
        "https://www.youtube.com/*",
        "https://studio.youtube.com/*",
        "https://www.facebook.com/*",
        "https://business.facebook.com/*",
        "https://x.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Buka saran balasan untuk teks komentar yang diblok"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon48.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}