# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies

# Local-only configuration and generated artifacts
.env
.env.*.local
!.env.example
*.jks
*.keystore
android/key.properties
supabase/.temp/
supabase/.branches/
coverage/

# Hallmark project memory is intentionally versioned; local preflight is not.
.hallmark/preflight.json

# Never commit portable toolchains or local APK exports.
.tooling/
artifacts/
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
.vercel
.env*

# Berkas APK tidak pernah masuk repo: ukurannya di atas batas 100MB GitHub,
# dan distribusi rilis memang lewat Cloudflare R2 + tabel app_releases
# (lihat docs/production-release-guide.md Bagian 3), bukan lewat git.
*.apk
